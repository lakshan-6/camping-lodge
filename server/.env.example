PORT=5000
DB_DRIVER=postgres
# Leave DATABASE_URL unset for the built-in local database with npm run dev.
# Set it explicitly for production or when using a separate PostgreSQL server.
# DATABASE_URL=postgresql://camping_lodge:replace-password@localhost:5432/camping_lodge
# Existing Atlas deployment only, during migration. Keep source credentials private.
# MONGODB_URI=
# AUTO_MIGRATE_FROM_MONGODB=false
# MIGRATION_SOURCE_URL=https://camping-lodge.onrender.com
AUTH_SECRET=replace-with-a-long-random-text
# Email (invoices are sent from this account). For Gmail use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional new-booking confirmations over HTTPS. Use a verified Brevo sender address.
BREVO_API_KEY=
BOOKING_EMAIL_FROM=

# Generate private random keys with npm run configure-auth before first start.
SETUP_KEY=
# Separate owner-only key for removing completed orders from Orders and Calendar.
PAST_ORDER_DELETE_KEY=
BACKUP_ENCRYPTION_KEY=
# Optional private S3-compatible backup bucket (never use a public bucket).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=camping-lodge
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
